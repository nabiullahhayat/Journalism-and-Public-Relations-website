# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/journalism_faculty

# JWT — use long random strings in production (openssl rand -base64 64)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (optional — leave blank if using local uploads only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — comma-separated frontend origins
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Security
TRUST_PROXY=false
RATE_LIMIT_SKIP_IPS=

# Optional API key for protected routes
API_KEY=

# Public URL for uploaded files
API_PUBLIC_URL=http://localhost:3001
